{
  "name": "@kora/extension-sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for building Kora extensions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "check:contracts": "bun scripts/check-contract-bundle.ts",
    "check:example": "bunx tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution bundler --lib ES2022,DOM --skipLibCheck examples/extension-conformance.ts",
    "test:extension-conformance": "bun examples/extension-conformance.ts",
    "lint": "neostandard",
    "lint:fix": "neostandard --fix",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "keywords": [
    "kora",
    "extension",
    "sdk",
    "low-code"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/asenawritescode/kora-ts-extension-sdk.git"
  },
  "license": "MIT",
  "devDependencies": {
    "neostandard": "^0.11.0",
    "typescript": "^5.7.0"
  }
}
